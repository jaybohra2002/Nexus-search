{
  "name": "@nexus/proto",
  "version": "1.0.0",
  "description": "Shared gRPC Protobuf definitions for Nexus Search",
  "private": true,
  "scripts": {
    "build": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=dist/ src/search.proto src/ingest.proto"
  },
  "devDependencies": {
    "@grpc/proto-loader": "^0.7.13"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.8"
  }
}
